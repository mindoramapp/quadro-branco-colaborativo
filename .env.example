# Porta do servidor (sinalização WebRTC, relay y-websocket, snapshots e, em produção, o build estático)
PORT=4444
# Segredo HMAC que assina os links das salas (editor/leitor). Gere com: openssl rand -hex 32
ROOM_SECRET=troque-este-segredo
# Arquivo SQLite com o estado das salas e os snapshots
DB_PATH=./data/quadro.db
# Servidores ICE para o WebRTC (JSON). Para redes com NAT simétrico, inclua um TURN.
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
